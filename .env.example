# Copy to .env. Never commit real secrets.

COMPANION_ENV=development
COMPANION_DEMO_MODE=true
COMPANION_API_TOKEN=change-me-local-token

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080

# Rainfall provider: nwdp (primary), demo, open_meteo (fallback)
RAINFALL_PROVIDER=nwdp
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
DEFAULT_LOCATION=Chennai
DEFAULT_LAT=13.0827
DEFAULT_LON=80.2707

# Optional AWS S3 (leave empty to use local filesystem fallback)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PREFIX=companion/

# Local fallback for models/rainfall cache (not patient history)
LOCAL_S3_DIR=data/local_s3

# Device simulator
DEVICE_ID=companion-01
BACKEND_URL=http://127.0.0.1:8080
